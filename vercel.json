{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "routes": [
        {
          "src": "^/api/api(?:/(.*))?$",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    },
    "worker": {
      "root": "services/worker",
      "entrypoint": "app.http:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/worker(/.*)?",
      "destination": {
        "type": "service",
        "service": "worker"
      }
    },
    {
      "source": "/api/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}

# Fill and uncomment needed settings; retain source defaults for omitted settings.
# Local bootstrap: keep this unset to avoid fetching hosted secrets.
# KALA_SECRETS_ARN=<OPTIONAL_HOSTED_SECRET_ARN_MAINTAINER_ONLY>

# Supabase backend connection and signing.
# SUPABASE_URL=<SET_SETTING>
# SUPABASE_SERVICE_KEY=<SET_SECRET>

# AWS region and optional worker invocation.
# AWS_REGION=<SET_SETTING>
# WORKER_FUNCTION_ARN=<SET_SETTING>

# Model routing and provider configuration.
# BEDROCK_EMBED_MODEL=<SET_SETTING>
# AI_PROVIDER=<SET_SETTING>
# EMBED_PROVIDER=<SET_SETTING>
# OPENROUTER_API_KEY=<SET_SECRET>
# OPENROUTER_BASE_URL=<SET_SETTING>
# OPENROUTER_EMBED_MODEL=<SET_SETTING>
# OPENROUTER_MODEL_FAST=<SET_SETTING>
# OPENROUTER_MODEL_DEFAULT=<SET_SETTING>
# OPENROUTER_MODEL_ITEM=<SET_SETTING>
# OPENROUTER_MODEL_BANK=<SET_SETTING>
# OPENAI_API_KEY=<SET_SECRET>
# OPENAI_BASE_URL=<SET_SETTING>
# OPENAI_EMBED_MODEL=<SET_SETTING>

# Worker reasoning and tracing.
# BANK_REASONING_EFFORT=<SET_SETTING>
# BANK_REASONING_MAX_TOKENS=<SET_INTEGER>
# TRACER_K=<SET_NUMBER>

# LTI and LMS integration.
# LMS_REST_BASE_URL=<SET_SETTING>
# LMS_REST_CLIENT_ID=<SET_SETTING>
# LMS_REST_CLIENT_SECRET=<SET_SECRET>
# LMS_VERIFY_TLS=<SET_BOOLEAN>
# LTI_AUTH_TOKEN_URL=<SET_SETTING>

# Fill and uncomment needed settings; retain source defaults for omitted settings.
# Local bootstrap: keep this unset to avoid fetching hosted secrets.
# KALA_SECRETS_ARN=<OPTIONAL_HOSTED_SECRET_ARN_MAINTAINER_ONLY>

# Supabase backend connection and signing.
# SUPABASE_URL=<SET_SETTING>
# SUPABASE_SERVICE_KEY=<SET_SECRET>
# SUPABASE_JWT_SECRET=<SET_SECRET>

# Launch and session behavior.
# FRONTEND_URL=<SET_SETTING>
# SESSION_TTL_SECONDS=<SET_INTEGER>
# SKILL_SEED_ON_LAUNCH=<SET_BOOLEAN>

# Model routing and provider configuration.
# BEDROCK_MODEL_FAST=<SET_SETTING>
# BEDROCK_MODEL_DEFAULT=<SET_SETTING>
# BEDROCK_MODEL_REASONING=<SET_SETTING>
# BEDROCK_MODEL_CHAT=<SET_SETTING>
# BEDROCK_MODEL_PREMIUM=<SET_SETTING>
# BEDROCK_EMBED_MODEL=<SET_SETTING>
# AI_PROVIDER=<SET_SETTING>
# OPENROUTER_API_KEY=<SET_SECRET>
# OPENROUTER_BASE_URL=<SET_SETTING>
# OPENROUTER_MODEL_FAST=<SET_SETTING>
# OPENROUTER_MODEL_DEFAULT=<SET_SETTING>
# OPENROUTER_MODEL_CHAT=<SET_SETTING>
# OPENROUTER_MODEL_CHAT_FALLBACK=<SET_SETTING>
# OPENROUTER_MODEL_REASONING=<SET_SETTING>
# OPENROUTER_MODEL_REASONING_FALLBACK=<SET_SETTING>
# OPENROUTER_MODEL_PREMIUM=<SET_SETTING>
# OPENROUTER_MODEL_ITEM=<SET_SETTING>
# OPENROUTER_MODEL_FALLBACK=<SET_SETTING>
# OPENROUTER_PROVIDER_ORDER=<SET_SETTING>
# OPENROUTER_EMBED_MODEL=<SET_SETTING>
# EMBED_PROVIDER=<SET_SETTING>
# OPENAI_API_KEY=<SET_SECRET>
# OPENAI_BASE_URL=<SET_SETTING>
# OPENAI_EMBED_MODEL=<SET_SETTING>

# AWS region and optional worker invocation.
# WORKER_FUNCTION_ARN=<SET_SETTING>
# AWS_REGION=<SET_SETTING>

# LTI 1.3 (Blackboard/Anthology) and LMS REST integration.
# Confirm LTI_ISSUER against the platform registration; Blackboard-issued launches use its issuer.
# Optional: load settings from AWS Secrets Manager instead; keep KALA_SECRETS_ARN unset locally.
# LTI_ISSUER=<SET_SETTING>
# LTI_CLIENT_ID=<SET_SETTING>
# LMS_VERIFY_TLS=<SET_BOOLEAN>
# LTI_AUTH_LOGIN_URL=<SET_SETTING>
# LTI_AUTH_TOKEN_URL=<SET_SETTING>
# LTI_KEYSET_URL=<SET_SETTING>
# LTI_DEPLOYMENT_IDS=<SET_SETTING>
# LTI_TOOL_PRIVATE_KEY_PEM=<SET_SECRET>
# LMS_REST_BASE_URL=<SET_SETTING>
# LMS_REST_CLIENT_ID=<SET_SETTING>
# LMS_REST_CLIENT_SECRET=<SET_SECRET>

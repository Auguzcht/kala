# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=service-role-key      # server only, never shipped to the client
SUPABASE_JWT_SECRET=your-supabase-jwt-secret  # used to mint the session token (HS256)

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
SESSION_TTL_SECONDS=3600

# ---- AWS / Bedrock ----
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_FAST=  # tagging, classification, and short summaries
BEDROCK_MODEL_DEFAULT=  # tutoring, RAG, and course Q&A
BEDROCK_MODEL_REASONING=  # hard reasoning escalation
BEDROCK_MODEL_PREMIUM=  # optional premium fallback
BEDROCK_EMBED_MODEL=

# ---- LTI 1.3 (Blackboard/Anthology) ----
# Issuer is always https://blackboard.com for Blackboard-issued launches.
LTI_ISSUER=https://blackboard.com
LTI_CLIENT_ID=your-application-client-id
LMS_VERIFY_TLS=true  # set false only for a trusted dev AMI with a self-signed certificate
LMS_REST_CLIENT_ID=your-application-key
LMS_REST_CLIENT_SECRET=your-rest-application-secret
LMS_REST_BASE_URL=https://<learn-host>/learn/api/public/v1
LTI_AUTH_LOGIN_URL=https://<learn-host>/api/v1/gateway/oidcauth
LTI_AUTH_TOKEN_URL=https://<learn-host>/learn/api/public/v1/oauth2/token
LTI_KEYSET_URL=https://<learn-host>/api/v1/management/oidc/discovery/jwks
LTI_DEPLOYMENT_IDS=deployment-id-from-school
LTI_TOOL_PRIVATE_KEY_PEM=   # the tool's RSA private key (PEM). Public key is served at /lti/jwks
# Optional: load the above from AWS Secrets Manager instead
KALA_SECRETS_ARN=
